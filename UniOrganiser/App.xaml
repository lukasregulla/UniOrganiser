<Application x:Class="UniOrganiser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:UniOrganiser"
             xmlns:converters="clr-namespace:UniOrganiser.Converters"
             xmlns:vm="clr-namespace:UniOrganiser.ViewModels"
             xmlns:views="clr-namespace:UniOrganiser.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:ColourSelectedConverter x:Key="ColourSelectedConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:IsSelectedDayConverter x:Key="IsSelectedDayConverter" />

            <!-- Category chip, shared by the task list rows and the calendar's day
                 panel. Bound against TaskListItemViewModel; collapses when the task
                 has no category. A pill, never a dot - dots mean subject. -->
            <DataTemplate x:Key="CategoryPillTemplate">
                <Border Background="{Binding CategoryColourHex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=0.15}"
                        BorderBrush="{Binding CategoryColourHex, Converter={StaticResource HexToBrushConverter}}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CategoryName}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{Binding CategoryColourHex, Converter={StaticResource HexToBrushConverter}}" />
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TaskListViewModel}">
                <views:TaskListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
                <views:CalendarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TagsViewModel}">
                <views:TagsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SemestersViewModel}">
                <views:SemestersView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
