<Application x:Class="UniOrganiser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:UniOrganiser"
             xmlns:converters="clr-namespace:UniOrganiser.Converters"
             xmlns:vm="clr-namespace:UniOrganiser.ViewModels"
             xmlns:views="clr-namespace:UniOrganiser.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:ColourSelectedConverter x:Key="ColourSelectedConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:IsSelectedDayConverter x:Key="IsSelectedDayConverter" />

            <DataTemplate DataType="{x:Type vm:TaskListViewModel}">
                <views:TaskListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
                <views:CalendarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubjectsViewModel}">
                <views:SubjectsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
