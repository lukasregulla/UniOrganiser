<Window x:Class="UniOrganiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UniOrganiser"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="UniOrganiser" Height="750" Width="1100" MinHeight="500" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton Content="Tasks" GroupName="MainTabs" Style="{StaticResource TabRadioButton}"
                             IsChecked="{Binding IsTasksActive}" Command="{Binding ShowTasksCommand}" />
                <RadioButton Content="Calendar" GroupName="MainTabs" Style="{StaticResource TabRadioButton}"
                             IsChecked="{Binding IsCalendarActive}" Command="{Binding ShowCalendarCommand}" />
                <RadioButton Content="Subjects" GroupName="MainTabs" Style="{StaticResource TabRadioButton}"
                             IsChecked="{Binding IsSubjectsActive}" Command="{Binding ShowSubjectsCommand}" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
