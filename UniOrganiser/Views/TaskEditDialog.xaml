<ui:FluentWindow x:Class="UniOrganiser.Views.TaskEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="{Binding DialogTitle}"
                 Height="720" Width="440"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Circle = subject, rounded square = category, matching the list and
             calendar marks, so the two axes stay distinguishable while tagging. -->
        <DataTemplate x:Key="SubjectOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                         Fill="{Binding ColourHex, Converter={StaticResource HexToBrushConverter}}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CategoryOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0" CornerRadius="2"
                        Background="{Binding ColourHex, Converter={StaticResource HexToBrushConverter}}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding DialogTitle}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
            <StackPanel>
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="What needs doing?"
                            Margin="0,0,0,16" />

                <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Any extra detail"
                            AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                            Margin="0,0,0,16" />

                <TextBlock Text="Subject" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding SubjectOptions}" SelectedItem="{Binding SelectedSubjectOption}"
                          ItemTemplate="{StaticResource SubjectOptionTemplate}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategoryOption}"
                          ItemTemplate="{StaticResource CategoryOptionTemplate}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Due date" Style="{StaticResource FieldLabel}" />
                        <!-- Native DatePicker, not ui:CalendarDatePicker: WPF-UI styles this one
                             (DefaultDatePickerStyle) and CalendarDatePicker renders blank when its
                             Date is set by a binding before the template is applied. -->
                        <DatePicker SelectedDate="{Binding DueDate}"
                                    FirstDayOfWeek="Monday"
                                    SelectedDateFormat="Short"
                                    HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Due time (HH:mm, optional)" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="09:00" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                <ui:ToggleSwitch Content="Completed" IsChecked="{Binding IsCompleted}" Margin="0,0,0,24" />

                <ui:CardExpander IsExpanded="{Binding IsPartOfExistingSeries, Mode=OneWay}"
                                 ContentPadding="16" Margin="0,0,0,16">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <TextBlock Text="Repeat" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </ui:CardExpander.Header>

                    <StackPanel>
                        <ComboBox ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding SelectedRepeatOption}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                        <StackPanel Visibility="{Binding ShowDaysPicker, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,16">
                            <TextBlock Text="On these days" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding DayToggles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                  Margin="0,0,16,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowRepeatEndDate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Repeat range" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding RepeatRangeOptions}"
                                      SelectedItem="{Binding SelectedRepeatRangeOption}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="{Binding SelectedSemesterHint}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding SelectedSemesterHint, Converter={StaticResource NullToVisibilityConverter}}" />

                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding ShowCustomRange, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Repeats from" Style="{StaticResource FieldLabel}" />
                                    <!-- Bound to DueDate on purpose: the series always starts at the
                                         first occurrence, so a separate start date could contradict it. -->
                                    <DatePicker SelectedDate="{Binding DueDate}"
                                                FirstDayOfWeek="Monday"
                                                SelectedDateFormat="Short"
                                                HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Repeats until" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding RepeatEndDate}"
                                                FirstDayOfWeek="Monday"
                                                SelectedDateFormat="Short"
                                                HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <StackPanel Visibility="{Binding IsPartOfExistingSeries, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,16">
                    <TextBlock Text="Apply changes to" Style="{StaticResource FieldLabel}" />
                    <RadioButton Content="This occurrence only" GroupName="Scope" HorizontalAlignment="Left"
                                 IsChecked="{Binding ApplyToAllFuture, Converter={StaticResource InverseBooleanConverter}}" />
                    <RadioButton Content="This and all future occurrences" GroupName="Scope" HorizontalAlignment="Left"
                                 Margin="0,8,0,0"
                                 IsChecked="{Binding ApplyToAllFuture}" />
                </StackPanel>

                <TextBlock Text="{Binding ValidationError}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
