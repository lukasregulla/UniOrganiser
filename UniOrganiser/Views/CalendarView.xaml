<UserControl x:Class="UniOrganiser.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:b="clr-namespace:UniOrganiser.Behaviours"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="WeekdayHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <DataTemplate x:Key="DayCellTemplate">
            <Border BorderThickness="1"
                    Margin="0,0,8,8"
                    Padding="8"
                    MinHeight="90"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <!-- ControlFillColorSecondaryBrush is nearly indistinguishable from
                                 Default in the dark theme, so dim the whole cell instead. -->
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource IsSelectedDayConverter}">
                                        <Binding Path="Date" />
                                        <Binding Path="DataContext.SelectedDay.Date"
                                                 RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Date.Day}" Margin="0,0,0,8"
                               HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding VisibleTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- Grid, not StackPanel: the title column must be
                                                     width-constrained for TextTrimming to engage. -->
                                                <Border Background="Transparent" ToolTip="{Binding TagTooltip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Category as a bar, subject as a dot: no room for a
                                                             pill here, and two dots would be unreadable.
                                                             Stays transparent when uncategorised so the chips
                                                             below it keep their left alignment. -->
                                                        <Border Grid.Column="0" Width="3" Margin="0,0,6,0"
                                                                CornerRadius="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background"
                                                                            Value="{Binding CategoryColourHex, Converter={StaticResource HexToBrushConverter}}" />
                                                                    <Style.Triggers>
                                                                        <!-- Transparent rather than collapsed: the bar
                                                                             keeps its width so every chip in the cell
                                                                             stays left-aligned. -->
                                                                        <DataTrigger Binding="{Binding HasCategory}" Value="False">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Fill="{Binding SubjectColourHex, Converter={StaticResource HexToBrushConverter}}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Task.Title}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <ui:SymbolIcon Grid.Column="3" Symbol="ArrowRepeatAll24" FontSize="11"
                                                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreCount, StringFormat='+{0} more'}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Today" Command="{Binding GoToTodayCommand}" Margin="0,0,8,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="CalendarToday24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button ToolTip="Previous month" AutomationProperties.Name="Previous month"
                           Command="{Binding PreviousMonthCommand}" Margin="0,0,8,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ChevronLeft24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button ToolTip="Next month" AutomationProperties.Name="Next month"
                           Command="{Binding NextMonthCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ChevronRight24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding MonthLabel}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="288" />
            </Grid.ColumnDefinitions>

            <!-- Transparent background so the whole area is hit-testable for swipe month
                 navigation, including the gaps between day cells. -->
            <Border Grid.Column="0"
                    x:Name="CalendarGridHost"
                    Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="7">
                        <TextBlock Text="Mon" Style="{StaticResource WeekdayHeader}" />
                        <TextBlock Text="Tue" Style="{StaticResource WeekdayHeader}" />
                        <TextBlock Text="Wed" Style="{StaticResource WeekdayHeader}" />
                        <TextBlock Text="Thu" Style="{StaticResource WeekdayHeader}" />
                        <TextBlock Text="Fri" Style="{StaticResource WeekdayHeader}" />
                        <TextBlock Text="Sat" Style="{StaticResource WeekdayHeader}" />
                        <TextBlock Text="Sun" Style="{StaticResource WeekdayHeader}" />
                    </UniformGrid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayCellTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedDay.Date, StringFormat='dddd, d MMMM'}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,0,0,16" />
                        <ui:Button Content="Add Task"
                                   Appearance="Primary"
                                   HorizontalAlignment="Left"
                                   Command="{Binding AddTaskCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" b:SmoothScroll.IsEnabled="True">
                        <StackPanel>
                            <TextBlock Text="No tasks on this day."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDay.TasksOnDay.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding SelectedDay.TasksOnDay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="16" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             Fill="{Binding SubjectColourHex, Converter={StaticResource HexToBrushConverter}}" />
                                                    <TextBlock Text="{Binding Task.Title}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               TextWrapping="Wrap" />
                                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="14"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   ToolTip="Repeating task"
                                                                   Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="16,8,0,8">
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource CategoryPillTemplate}"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Task.DueTime, StringFormat='{}{0:hh\\:mm}'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                                    <ui:Button Appearance="Secondary"
                                                               ToolTip="Edit"
                                                               AutomationProperties.Name="Edit task"
                                                               Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Edit24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                    <ui:Button Appearance="Secondary"
                                                               ToolTip="Delete"
                                                               AutomationProperties.Name="Delete task"
                                                               Margin="8,0,0,0"
                                                               Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Delete24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
