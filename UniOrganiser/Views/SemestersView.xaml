<UserControl x:Class="UniOrganiser.Views.SemestersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="600">
    <UserControl.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="EditorFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Primary"
                           Content="Add Semester"
                           Command="{Binding AddSemesterCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Semesters" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1">
                <TextBlock Text="No semesters yet. Add one so recurring tasks know when to stop and which weeks to skip.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Semesters.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Semesters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardExpander ContentPadding="16" Margin="0,0,0,8">
                                    <ui:CardExpander.Icon>
                                        <ui:SymbolIcon Symbol="CalendarClock24" />
                                    </ui:CardExpander.Icon>
                                    <ui:CardExpander.Header>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0,16,0">
                                                <ui:Button Appearance="Secondary"
                                                           ToolTip="Edit"
                                                           AutomationProperties.Name="Edit semester"
                                                           Command="{Binding DataContext.EditSemesterCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Edit24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary"
                                                           ToolTip="Delete"
                                                           AutomationProperties.Name="Delete semester"
                                                           Margin="8,0,0,0"
                                                           Command="{Binding DataContext.DeleteSemesterCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Delete24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{Binding DateRangeLabel}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ui:CardExpander.Header>

                                    <StackPanel>
                                        <TextBlock Text="Breaks"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="No breaks. Recurring tasks will run every week of this semester.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Breaks.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Breaks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="16,8"
                                                            Margin="0,0,0,8">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <ui:Button Appearance="Secondary"
                                                                           ToolTip="Edit"
                                                                           AutomationProperties.Name="Edit break"
                                                                           Command="{Binding DataContext.EditBreakCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:Button.Icon>
                                                                        <ui:SymbolIcon Symbol="Edit24" />
                                                                    </ui:Button.Icon>
                                                                </ui:Button>
                                                                <ui:Button Appearance="Secondary"
                                                                           ToolTip="Delete"
                                                                           AutomationProperties.Name="Delete break"
                                                                           Margin="8,0,0,0"
                                                                           Command="{Binding DataContext.DeleteBreakCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:Button.Icon>
                                                                        <ui:SymbolIcon Symbol="Delete24" />
                                                                    </ui:Button.Icon>
                                                                </ui:Button>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                                       VerticalAlignment="Center"
                                                                       Width="200" />
                                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:d MMM yyyy} – {1:d MMM yyyy}">
                                                                        <Binding Path="StartDate" />
                                                                        <Binding Path="EndDate" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ui:Button Content="Add break"
                                                   Appearance="Secondary"
                                                   HorizontalAlignment="Left"
                                                   Command="{Binding DataContext.AddBreakCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Add24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </ui:CardExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Editor overlay, shared by semesters and breaks -->
        <Border Background="{DynamicResource SmokeFillColorDefaultBrush}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource ContentDialogBackground}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}"
                    Padding="24" Width="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Name" Style="{StaticResource EditorFieldLabel}" />
                    <ui:TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding NamePlaceholder}"
                                Margin="0,0,0,16" />

                    <TextBlock Text="Starts" Style="{StaticResource EditorFieldLabel}" />
                    <DatePicker SelectedDate="{Binding EditingStartDate}"
                                FirstDayOfWeek="Monday"
                                SelectedDateFormat="Short"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16" />

                    <TextBlock Text="Ends" Style="{StaticResource EditorFieldLabel}" />
                    <DatePicker SelectedDate="{Binding EditingEndDate}"
                                FirstDayOfWeek="Monday"
                                SelectedDateFormat="Short"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16" />

                    <TextBlock Text="{Binding ValidationError}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Margin="0,0,0,16" TextWrapping="Wrap"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
